# REDIS CONFIGURATION (Menyesuaikan dengan Redis WSL yang sudah kita buat di Step 09)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# POSTGRESQL DATABASE CONFIGURATION (Menyesuaikan dengan database backend Anda)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fuel_manager_db
DB_USER=postgres
DB_PASSWORD=iam28

# MODEL CONFIGURATION
MODEL_VERSION=v1_rule_based

# WHATSAPP NOTIFICATION (Fonnte — https://fonnte.com)
# Isi WA_API_KEY dengan token dari dashboard Fonnte setelah pairing nomor
WA_PROVIDER=fonnte
WA_API_KEY=GANTI_DENGAN_TOKEN_FONNTE_ANDA
WA_ADMIN_PHONE=628xxxxxxxxxx

# OCR ANOMALY THRESHOLDS (Harga BBM dalam Rupiah)
OCR_PRICE_MIN=5000
OCR_PRICE_MAX=20000

# PATH ke folder uploads backend (relatif dari folder ml-engine)
UPLOADS_BASE_PATH=../backend/uploads/